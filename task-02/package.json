{
  "name": "task-02-restful-booker-api",
  "version": "1.0.0",
  "description": "Tugas 2 After Office - Cypress: API E2E testing untuk Restful Booker (auth, createBooking, getBooking, deleteBooking)",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run --spec 'cypress/e2e/booking-api.cy.js'",
    "test:report": "cypress run && npm run report:merge && npm run report:generate",
    "report:merge": "mochawesome-merge cypress/reports/*.json > cypress/reports/mochawesome-bundle.json",
    "report:generate": "marge cypress/reports/mochawesome-bundle.json --reportDir cypress/reports/html --inline",
    "clean:reports": "rm -rf cypress/reports cypress/screenshots cypress/videos",
    "ci:test": "cypress run --browser chrome --headless --spec 'cypress/e2e/**/*.cy.js'"
  },
  "keywords": [
    "cypress",
    "api-testing",
    "e2e",
    "restful-booker",
    "after-office"
  ],
  "author": "testwiththeo",
  "license": "ISC",
  "devDependencies": {
    "cypress": "^13.6.0",
    "cypress-mochawesome-reporter": "^3.8.0",
    "dotenv": "^16.4.5",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
